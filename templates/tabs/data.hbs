{{!-- DATA: level / skills / perks / traits --}}
<div class="pip-data">

	<div class="pip-inv-summary">
		<span class="pip-editable" data-edit-path="system.level.value" data-edit-label="LEVEL"
			data-edit-min="1" data-tooltip="Right-click to edit">LEVEL {{data.level}}</span>
		<span class="pip-editable" data-edit-path="system.level.currentXP" data-edit-label="CURRENT XP"
			data-tooltip="Right-click to edit">XP {{data.currentXP}}{{#if data.nextLevelXP}} / {{data.nextLevelXP}}{{/if}}</span>
	</div>
	{{#if data.origin}}<div class="pip-origin">Origin: {{data.origin}}</div>{{/if}}

	<h3 class="pip-section-title"><i class="fas fa-list-check"></i> SKILLS</h3>
	<ul class="pip-skill-list">
		{{#each data.skills}}
		<li class="pip-skill{{#if tagged}} tagged{{/if}}" data-item-id="{{id}}">
			<span class="pip-skill-name" data-action="rollSkill"
				data-tooltip="Roll {{name}} ({{attribute}}) — right-click for attribute and rank">{{name}}</span>
			<span class="pip-skill-attr">{{attribute}}</span>
			<span class="pip-skill-rank">{{rank}}</span>
			{{#if tagged}}<i class="fas fa-tag pip-tag" data-tooltip="Tagged"></i>{{/if}}
			<span class="pip-skill-attrs">
				{{#each @root.data.attrs}}
				<button type="button" class="pip-attr-pick" data-action="rollSkill" data-attr="{{key}}"
					data-tooltip="Roll with {{label}}">{{letter}}</button>
				{{/each}}
				<span class="pip-skill-edit">
					<button type="button" class="pip-edit-step" data-action="adjustSkill"
						data-delta="-1" data-tooltip="Lower the rank">&minus;</button>
					<span class="pip-skill-edit-val">{{rank}}</span>
					<button type="button" class="pip-edit-step" data-action="adjustSkill"
						data-delta="1" data-tooltip="Raise the rank">+</button>
				</span>
			</span>
		</li>
		{{else}}
		<li class="pip-empty">No skills.</li>
		{{/each}}
	</ul>

	<h3 class="pip-section-title"><i class="fas fa-star"></i> PERKS</h3>
	<ul class="pip-perk-list">
		{{#each data.perks}}
		<li class="pip-perk" data-item-id="{{id}}" data-action="showInfo" data-tooltip="View details">
			<img class="pip-item-img" src="{{img}}" alt="" />
			<span class="pip-item-name">{{name}}</span>
			{{#if multiRank}}<span class="pip-perk-rank">Rank {{rank}}/{{rankMax}}</span>{{/if}}
		</li>
		{{else}}
		<li class="pip-empty">No perks.</li>
		{{/each}}
	</ul>

	{{#if data.traits.length}}
	<h3 class="pip-section-title"><i class="fas fa-dna"></i> TRAITS</h3>
	<ul class="pip-perk-list">
		{{#each data.traits}}
		<li class="pip-perk" data-item-id="{{id}}" data-action="showInfo" data-tooltip="View details">
			<img class="pip-item-img" src="{{img}}" alt="" />
			<span class="pip-item-name">{{name}}</span>
		</li>
		{{/each}}
	</ul>
	{{/if}}

	{{#if data.effects.length}}
	<h3 class="pip-section-title"><i class="fas fa-bolt"></i> EFFECTS</h3>
	<ul class="pip-effect-list">
		{{#each data.effects}}
		<li class="pip-effect pip-effect-{{state}}">
			<img class="pip-item-img" src="{{img}}" alt="" />
			<span class="pip-item-name">{{name}}</span>
			{{#if duration}}<span class="pip-effect-duration">{{duration}}</span>{{/if}}
			{{#if showState}}<span class="pip-effect-state">{{state}}</span>{{/if}}
		</li>
		{{/each}}
	</ul>
	{{/if}}

</div>
