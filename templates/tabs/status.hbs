{{!-- STATUS: HP, condition (limbs), SPECIAL, rads & needs --}}
<div class="pip-status">

	<div class="pip-hp-block">
		<div class="pip-hp-label">
			<span>HP</span>
			<span class="pip-hp-controls">
				<button type="button" class="pip-step-btn" data-action="adjustHp" data-delta="-1" data-tooltip="Damage 1">&minus;</button>
				<span class="pip-hp-num">{{status.health.value}} / {{status.health.max}}</span>
				<button type="button" class="pip-step-btn" data-action="adjustHp" data-delta="1" data-tooltip="Heal 1">+</button>
			</span>
		</div>
		<div class="pip-bar">
			<div class="pip-bar-fill" style="width:{{status.health.pct}}%"></div>
		</div>
	</div>

	<div class="pip-vitals">
		<div class="pip-vital"><span class="pip-vital-val">{{status.defense}}</span><span class="pip-vital-key">DEF</span></div>
		<div class="pip-vital"><span class="pip-vital-val">{{status.initiative}}</span><span class="pip-vital-key">INIT</span></div>
		<div class="pip-vital pip-editable" data-edit-path="system.radiation" data-edit-label="RADS"
			data-tooltip="Right-click to edit"><span class="pip-vital-val">{{status.radiation}}</span><span class="pip-vital-key">RADS</span></div>
		<div class="pip-vital pip-editable" data-edit-path="system.luckPoints" data-edit-label="LUCK POINTS"
			data-tooltip="Right-click to edit"><span class="pip-vital-val">{{status.luckPoints}}</span><span class="pip-vital-key">LUCK</span></div>
		<div class="pip-vital pip-editable" data-edit-path="system.currency.caps" data-edit-label="CAPS"
			data-tooltip="Right-click to edit"><span class="pip-vital-val">{{status.caps}}</span><span class="pip-vital-key">CAPS</span></div>
		<div class="pip-vital{{#if status.carryWeight.level}} pip-encumbered{{/if}}" data-tooltip="Carried / capacity"><span class="pip-vital-val">{{status.carryWeight.current}}/{{status.carryWeight.max}}</span><span class="pip-vital-key">WT</span></div>
	</div>

	{{#if status.actions}}
	<div class="pip-actions">
		<span class="pip-actions-label">ACTIONS</span>
		<button type="button" class="pip-action-pip{{#if status.actions.majorSpent}} spent{{/if}}"
			data-action="toggleAction" data-kind="major"
			data-tooltip="Major action — click to spend; when spent, buy another for 2 AP">
			<span class="pip-dots">&bull;&bull;</span> MAJOR{{#if status.actions.majorCount}} ×{{status.actions.majorCount}}{{/if}}
		</button>
		<button type="button" class="pip-action-pip{{#if status.actions.minorSpent}} spent{{/if}}"
			data-action="toggleAction" data-kind="minor"
			data-tooltip="Minor action — click to spend; when spent, buy another for 1 AP">
			<span class="pip-dots">&bull;</span> MINOR{{#if status.actions.minorCount}} ×{{status.actions.minorCount}}{{/if}}
		</button>
		<button type="button" class="pip-action-pip pip-aim{{#if status.actions.aiming}} aiming{{/if}}"
			data-action="toggleAim"
			data-tooltip="Aim — a minor action that benefits your next attack (Accurate weapons can then buy damage dice at 1 AP each)">
			<i class="fas fa-crosshairs"></i> {{#if status.actions.aiming}}AIMING{{else}}AIM{{/if}}
		</button>
		<button type="button" class="pip-icon-btn" data-action="resetActions" data-tooltip="Reset actions">
			<i class="fas fa-rotate-left"></i>
		</button>
	</div>
	{{/if}}

	{{#if status.favorites.any}}
	<h3 class="pip-section-title"><i class="fas fa-star"></i> FAVORITES</h3>
	<div class="pip-favs">
		{{#if status.favorites.weapons.length}}
		<div class="pip-fav-group">
			<span class="pip-fav-label">WEAPONS</span>
			{{!-- Weapons get two rows: name, then damage left / actions right --}}
			{{#each status.favorites.weapons}}
			<div class="pip-fav pip-fav-weapon{{#if equipped}} equipped{{/if}}" data-item-id="{{id}}">
				<div class="pip-fav-line">
					<img class="pip-item-img" src="{{img}}" alt="" data-action="showInfo" data-tooltip="View details" />
					<span class="pip-item-name" data-action="showInfo" data-tooltip="View details">{{name}}</span>
				</div>
				<div class="pip-fav-line pip-fav-line-2">
					<span class="pip-item-sub">{{#if subtitle}}{{subtitle}}{{/if}}</span>
					<span class="pip-item-actions">
						<button type="button" class="pip-icon-btn pip-attack-btn" data-action="attackWeapon"
							data-tooltip="Roll attack"><i class="fas fa-crosshairs"></i></button>
						<button type="button" class="pip-icon-btn pip-damage-btn" data-action="damageWeapon"
							data-tooltip="Roll damage"><i class="fas fa-burst"></i></button>
						<button type="button" class="pip-icon-btn pip-unfav-btn" data-action="toggleFavorite"
							data-tooltip="Remove from favorites"><i class="fas fa-star"></i></button>
					</span>
				</div>
			</div>
			{{/each}}
		</div>
		{{/if}}
		{{#if status.favorites.consumables.length}}
		<div class="pip-fav-group">
			<span class="pip-fav-label">CONSUMABLES</span>
			{{#each status.favorites.consumables}}
			<div class="pip-fav" data-item-id="{{id}}">
				<img class="pip-item-img" src="{{img}}" alt="" data-action="showInfo" data-tooltip="View details" />
				<span class="pip-item-name" data-action="showInfo" data-tooltip="View details">{{name}}</span>
				{{#if quantity}}<span class="pip-item-qty">×{{quantity}}</span>{{/if}}
				<span class="pip-item-actions">
					<button type="button" class="pip-icon-btn pip-use-btn" data-action="useConsumable"
						data-tooltip="Use"><i class="fas fa-mortar-pestle"></i></button>
					<button type="button" class="pip-icon-btn pip-unfav-btn" data-action="toggleFavorite"
						data-tooltip="Remove from favorites"><i class="fas fa-star"></i></button>
				</span>
			</div>
			{{/each}}
		</div>
		{{/if}}
	</div>
	{{/if}}

	<h3 class="pip-section-title">CONDITION</h3>
	<div class="pip-condition">
		<div class="pip-body pipboy-status-screen {{status.bodyType}}">
			{{#each status.bodyFigure}}
			<div class="pip-body-part pip-limb-{{status}}" data-limb="{{key}}"
				style="--limb-src:url('{{src}}')"></div>
			{{/each}}
		</div>
		<div class="pip-limbs">
			{{#each status.limbs}}
			<div class="pip-limb pip-limb-{{status}}" data-limb="{{key}}">
				<span class="pip-limb-name">{{label}}</span>
				<span class="pip-limb-status">{{status}}</span>
				<span class="pip-injuries" data-tooltip="Click to cycle: none → wounded → crippled">
					{{#each injuries}}
					<button type="button" class="pip-injury-pip pip-injury-{{value}}"
						data-action="cycleInjury" data-limb="{{../key}}" data-index="{{index}}"></button>
					{{/each}}
				</span>
			</div>
			{{/each}}
		</div>
	</div>

	{{#if status.powerArmor.available}}
	<h3 class="pip-section-title">POWER ARMOR</h3>
	<div class="pip-pa">
		{{#each status.powerArmor.frames}}
		<div class="pip-pa-frame">
			<span class="pip-pa-name" data-tooltip="{{name}}">{{name}}</span>
			<button type="button" class="pip-pa-power{{#if powered}} on{{/if}}" data-action="togglePaPower"
				data-item-id="{{id}}" data-tooltip="{{#if powered}}Power down{{else}}Power up{{/if}}">
				<i class="fas fa-power-off"></i> {{#if powered}}POWERED{{else}}OFFLINE{{/if}}
			</button>
		</div>
		{{/each}}
		{{#each status.powerArmor.pieces}}
		<div class="pip-pa-row pip-editable" data-edit-item-id="{{itemId}}" data-edit-path="system.health.value"
			data-edit-label="{{label}} HP" data-edit-max="{{max}}" data-tooltip="{{name}} — right-click to edit">
			<span class="pip-pa-loc">{{label}}</span>
			<div class="pip-bar pip-pa-bar"><div class="pip-bar-fill" style="width:{{pct}}%"></div></div>
			<span class="pip-hp-controls">
				<button type="button" class="pip-step-btn" data-action="adjustPaHealth"
					data-item-id="{{itemId}}" data-delta="-1" data-tooltip="Damage 1">&minus;</button>
				<span class="pip-pa-num">{{value}} / {{max}}</span>
				<button type="button" class="pip-step-btn" data-action="adjustPaHealth"
					data-item-id="{{itemId}}" data-delta="1" data-tooltip="Repair 1">+</button>
			</span>
		</div>
		{{/each}}
	</div>
	{{/if}}

	<h3 class="pip-section-title">RESISTANCES</h3>
	<div class="pip-resist">
		<div class="pip-resist-row pip-resist-head">
			<span></span><span data-tooltip="Physical">PHYS</span><span data-tooltip="Energy">EN</span><span data-tooltip="Radiation">RAD</span><span data-tooltip="Poison">PSN</span>
		</div>
		{{#each status.resistances}}
		<div class="pip-resist-row">
			<span class="pip-resist-loc">{{label}}</span>
			<span>{{physical}}</span><span>{{energy}}</span><span>{{radiation}}</span><span>{{poison}}</span>
		</div>
		{{/each}}
	</div>

	<h3 class="pip-section-title">S.P.E.C.I.A.L.</h3>
	<div class="pip-special">
		{{#each status.special}}
		<div class="pip-attr" data-tooltip="{{label}}">
			<span class="pip-attr-letter">{{letter}}</span>
			<span class="pip-attr-val">{{value}}</span>
		</div>
		{{/each}}
	</div>

	<h3 class="pip-section-title">NEEDS</h3>
	<div class="pip-needs">
		{{#each status.conditions}}
		<div class="pip-need{{#if editPath}} pip-editable{{/if}}"{{#if editPath}}
			data-edit-path="{{editPath}}" data-edit-label="{{editLabel}}" data-tooltip="Right-click to edit"{{/if}}>
			<span>{{label}}</span>
			{{#if options}}
			<select class="pip-need-select" data-key="{{key}}">
				{{#each options}}
				<option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>
				{{/each}}
			</select>
			{{else}}
			<span class="pip-need-val">{{value}}</span>
			{{/if}}
		</div>
		{{/each}}
	</div>

</div>
